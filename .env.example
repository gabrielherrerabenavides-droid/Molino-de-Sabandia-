# ---------------------------------------------------------------------------
# Molino de Sabandía — variables de entorno
#
# Copia este archivo a `.env.local` para desarrollo, o configúralas en Vercel
# (Project Settings → Environment Variables). Ninguna es obligatoria para
# arrancar: sin ellas el sitio funciona en modo degradado (reservas en archivo
# local, correos omitidos, /admin cerrado).
# ---------------------------------------------------------------------------

# URL pública del sitio. Se usa en las URL canónicas, en Open Graph y en los
# enlaces de los correos de reservas.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Base de datos -----------------------------------------------------------
# Cadena de conexión de Neon / Vercel Postgres. Si falta, `src/lib/store.ts`
# guarda las reservas en `.data/reservas.json` (desarrollo) o en /tmp
# (producción: efímero, se pierde en cada despliegue).
DATABASE_URL=""
# Alternativa aceptada por store.ts si prefieres el nombre de Vercel Postgres.
# POSTGRES_URL=""

# --- Correo transaccional (Resend) -------------------------------------------
# Sin RESEND_API_KEY no se envía ningún correo y ninguna petición falla por ello.
RESEND_API_KEY=""
# Remitente verificado en Resend (dominio validado con SPF/DKIM).
MAIL_FROM="Molino de Sabandía <no-reply@molinodesabandia.com>"
# Buzón que recibe el aviso de cada nueva solicitud de reserva.
# Por defecto, el correo de `SITE.contact.email` en src/content/site.ts.
RESERVAS_NOTIFY_EMAIL=""

# --- Administración ----------------------------------------------------------
# Autenticación HTTP Basic de /admin y /api/admin (ver `src/proxy.ts`).
# Si falta cualquiera de las dos, /admin responde 503 y no expone nada.
ADMIN_USER=""
ADMIN_PASSWORD=""
