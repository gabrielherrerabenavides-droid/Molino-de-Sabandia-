# ---------------------------------------------------------------------------
# Molino de Sabandía — variables de entorno
#
# Copia este archivo a `.env.local` para desarrollo, o configúralas en Vercel
# (Project Settings → Environment Variables). En desarrollo ninguna es
# obligatoria: sin ellas el sitio funciona en modo degradado (reservas en
# archivo local, correos omitidos, /admin cerrado).
#
# EN PRODUCCIÓN `DATABASE_URL` SÍ ES OBLIGATORIA (ver más abajo).
# ---------------------------------------------------------------------------

# URL pública del sitio. Se usa en las URL canónicas, en Open Graph y en los
# enlaces de los correos de reservas.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Base de datos (OBLIGATORIA EN PRODUCCIÓN) -------------------------------
# Cadena de conexión de Neon / Vercel Postgres.
# Si falta, `src/lib/store.ts` guarda en `.data/*.json` (desarrollo) o en /tmp
# (producción: efímero, se pierde en cada despliegue y en cada instancia nueva).
# Consecuencias de desplegar sin ella:
#   - el Libro de Reclamaciones se desactiva: `POST /api/reclamaciones` responde
#     503, porque no se pueden conservar las hojas los 2 años que exige el
#     D.S. N.º 011-2011-PCM;
#   - las reservas se guardan en /tmp y se pierden sin aviso.
DATABASE_URL=""
# Alternativa aceptada por store.ts si prefieres el nombre de Vercel Postgres.
# POSTGRES_URL=""

# Solo para auto-alojamiento sin Postgres: carpeta persistente donde el modo
# archivo guarda los JSON. Al indicarla declaras que ese volumen sobrevive a los
# reinicios, así que el Libro de Reclamaciones vuelve a aceptar hojas. En Vercel
# NO la uses: el sistema de archivos es efímero.
# MOLINO_DATA_DIR="/var/lib/molino"

# --- Correo transaccional (Resend) -------------------------------------------
# Sin RESEND_API_KEY no se envía ningún correo y ninguna petición falla por ello.
RESEND_API_KEY=""
# Remitente verificado en Resend (dominio validado con SPF/DKIM).
MAIL_FROM="Molino de Sabandía <no-reply@molinodesabandia.com>"
# Buzón que recibe el aviso de cada nueva solicitud de reserva.
# Por defecto, el correo de `SITE.contact.email` en src/content/site.ts.
RESERVAS_NOTIFY_EMAIL=""

# --- Administración ----------------------------------------------------------
# Autenticación HTTP Basic de /admin y /api/admin (ver `src/proxy.ts`).
# Si falta cualquiera de las dos, /admin responde 503 y no expone nada.
# ADMIN_PASSWORD: usa 20+ caracteres aleatorios y únicos (p. ej. `openssl rand -base64 24`).
# El proxy bloquea la IP 15 minutos tras 10 intentos fallidos, pero el contador
# vive en la memoria de cada instancia: no sustituye a una contraseña fuerte.
ADMIN_USER=""
ADMIN_PASSWORD=""
